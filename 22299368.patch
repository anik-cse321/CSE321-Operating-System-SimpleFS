diff --git a/user/lotterytest.c b/user/lotterytest.c
new file mode 100644
index 0000000..bef555a
--- /dev/null
+++ b/user/lotterytest.c
@@ -0,0 +1,46 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+void
+run_test(int tickets, int start, int end)
+{
+  volatile unsigned long count = 0;
+
+  settickets(tickets);
+
+  // Wait until all processes reach the common start time.
+  while(uptime() < start)
+    ;
+
+  // CPU-bound work during the same time interval.
+  while(uptime() < end)
+    count++;
+
+  printf("tickets=%d count=%lu\n", tickets, count);
+  exit(0);
+}
+
+int
+main(void)
+{
+  int start = uptime() + 20;
+  int end = start + 100;
+
+  int pid1 = fork();
+  if(pid1 == 0)
+    run_test(10, start, end);
+
+  int pid2 = fork();
+  if(pid2 == 0)
+    run_test(20, start, end);
+
+  int pid3 = fork();
+  if(pid3 == 0)
+    run_test(40, start, end);
+
+  wait(0);
+  wait(0);
+  wait(0);
+
+  exit(0);
+}
